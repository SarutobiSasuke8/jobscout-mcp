{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "jobs": {
      "items": {
        "properties": {
          "company": {
            "maxLength": 300,
            "minLength": 1,
            "type": "string"
          },
          "description": {
            "maxLength": 100000,
            "type": "string"
          },
          "location": {
            "default": "Unknown",
            "maxLength": 5000,
            "type": "string"
          },
          "tags": {
            "default": [],
            "items": {
              "maxLength": 80,
              "minLength": 1,
              "type": "string"
            },
            "maxItems": 100,
            "type": "array"
          },
          "title": {
            "maxLength": 300,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "title",
          "company"
        ],
        "type": "object"
      },
      "maxItems": 1000,
      "minItems": 1,
      "type": "array"
    }
  },
  "required": [
    "jobs"
  ],
  "type": "object"
}
