# Copy to deploy/.env on the server and edit. Compose reads it automatically.
# No secrets are needed for the anonymous public service; never commit deploy/.env.

# Public host name. A bare name gets automatic HTTPS (Let's Encrypt) once DNS points here.
JOBSCOUT_SITE_ADDRESS=jobscout.mcprack.dev
JOBSCOUT_HTTP_PORT=80
JOBSCOUT_HTTPS_PORT=443

# Image tag for both services. Set a release or commit tag to make rollback a one-line change.
JOBSCOUT_IMAGE_TAG=local

# Per-IP limits at the proxy (sliding window). Over the limit: HTTP 429 with Retry-After.
JOBSCOUT_MCP_RATE_EVENTS=60
JOBSCOUT_MCP_RATE_WINDOW=1m
JOBSCOUT_MCP_MAX_BODY=64KB
JOBSCOUT_SITE_RATE_EVENTS=120
JOBSCOUT_SITE_RATE_WINDOW=1m

# Sources the hosted service searches. JobSpy is always off when hosted.
# Read docs/PROVIDERS.md before enabling any source.
JOBSCOUT_ENABLE_HIMALAYAS=true
JOBSCOUT_ENABLE_WEWORKREMOTELY=false
JOBSCOUT_ENABLE_REMOTEOK=false
JOBSCOUT_ENABLE_LENNYSJOBS=false
JOBSCOUT_MAX_RESULTS=100
JOBSCOUT_FEED_CACHE_TTL_MS=300000
