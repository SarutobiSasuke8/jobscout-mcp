# Local trial without a domain: plain HTTP on http://localhost:8088.
#   docker compose --env-file local.env up --build
# For TLS from Caddy's internal CA instead, set JOBSCOUT_SITE_ADDRESS=localhost and use
# https://localhost:8443 (curl -k, or trust the root from the caddy_data volume).
JOBSCOUT_SITE_ADDRESS=:80
JOBSCOUT_HTTP_PORT=8088
JOBSCOUT_HTTPS_PORT=8443
JOBSCOUT_IMAGE_TAG=local

# Lower limits so the load test reaches 429 quickly.
JOBSCOUT_MCP_RATE_EVENTS=20
JOBSCOUT_MCP_RATE_WINDOW=1m
JOBSCOUT_MCP_MAX_BODY=64KB
JOBSCOUT_SITE_RATE_EVENTS=120
JOBSCOUT_SITE_RATE_WINDOW=1m

# No sources enabled: searches return setup guidance and nothing leaves the machine.
JOBSCOUT_ENABLE_HIMALAYAS=false
