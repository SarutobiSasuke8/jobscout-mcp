# Providers are opt-in. No remote service is contacted unless enabled.
JOBSCOUT_ENABLE_HIMALAYAS=false
HIMALAYAS_MCP_URL=https://mcp.himalayas.app/mcp

# Enabling JobSpy sends automated requests FROM THIS MACHINE to the sites listed in
# JOBSPY_SITES. Default is Indeed only. LinkedIn, Glassdoor and Indeed each restrict
# automated access in their terms of use. See docs/PROVIDERS.md before widening this.
JOBSCOUT_ENABLE_JOBSPY=false
JOBSPY_PYTHON=python
JOBSPY_TIMEOUT_MS=45000
# Comma-separated: indeed, linkedin, glassdoor, google, zip_recruiter, bayt, naukri
JOBSPY_SITES=indeed
# Indeed is country-scoped. Unset defers to the python-jobspy default.
JOBSPY_COUNTRY=

# Lenny's Job Board. No endpoint ships with JobScout: set LENNYSJOBS_FEED_URL to a public
# JSON feed you have verified and are entitled to read. See docs/PROVIDERS.md.
JOBSCOUT_ENABLE_LENNYSJOBS=false
LENNYSJOBS_FEED_URL=
# Optional: forward the search term server-side instead of filtering locally, e.g. q
LENNYSJOBS_QUERY_PARAM=
LENNYSJOBS_SITE_URL=https://www.lennysjobs.com
LENNYSJOBS_TIMEOUT_MS=20000

JOBSCOUT_MAX_RESULTS=100
